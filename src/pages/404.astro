---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="The page you were looking for does not exist. Head back to the Tidewell home page or browse the journal." noindex={true}>
  <section class="band page-head"><div class="wrap narrow">
    <p class="eyebrow">Error 404</p>
    <h1>Page not found</h1>
    <p class="lead">That page has moved or never existed.</p>
    <p class="btn-row"><a class="btn" href="/">Go home</a><a class="btn btn-secondary" href="/journal/">Browse the journal</a></p>
  </div></section>
</Base>
