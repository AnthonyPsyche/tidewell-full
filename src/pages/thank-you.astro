---
import Base from "../layouts/Base.astro";
---
<Base title="Thank you" description="Your message has been sent to Tidewell Coffee. We reply within one business day." noindex={true}>
  <section class="band page-head"><div class="wrap narrow">
    <p class="eyebrow">Message sent</p>
    <h1>Thank you</h1>
    <p class="lead">Your message is on its way. We reply within one business day.</p>
    <p class="btn-row"><a class="btn" href="/journal/">Read the journal</a><a class="btn btn-secondary" href="/">Back to the home page</a></p>
  </div></section>
</Base>
