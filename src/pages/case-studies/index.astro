---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getCaseStudies } from "../../lib/content";
const items = await getCaseStudies();
---
<Base title="Case studies" description="How cafes, restaurants and offices serve better coffee with Tidewell: real programs, real results, in their own words.">
  <section class="band page-head"><div class="wrap">
    <p class="eyebrow">Wholesale partners</p>
    <h1>Case studies</h1>
    <p class="lead">How cafes, restaurants and offices serve better coffee with Tidewell.</p>
  </div></section>
  <section><div class="wrap">
    <h2 class="sr-only">All case studies</h2>
    <div class="grid-3">
      {items.map((c) => <PostCard href={`/case-studies/${c.id}/`} image={c.data.cover} kicker={c.data.location} title={c.data.title} summary={c.data.description} />)}
    </div>
  </div></section>
</Base>
