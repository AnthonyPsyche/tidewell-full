---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts, slugify } from "../../lib/content";
import { CATEGORIES } from "../../content.config";
const posts = await getPosts();
const counts = Object.fromEntries(CATEGORIES.map((c) => [c, posts.filter((p) => p.data.category === c).length]));
---
<Base title="Journal" description="Brewing guides, roasting notes and stories from the coast: practical coffee knowledge from the Tidewell roastery.">
  <section class="band page-head"><div class="wrap">
    <p class="eyebrow">The Tidewell journal</p>
    <h1>Coffee, explained</h1>
    <p class="lead">Brewing guides, roasting notes and stories from the roastery.</p>
    <nav aria-label="Journal categories" class="chips">
      <a class="chip" href="/journal/" aria-current="page">All posts</a>
      {CATEGORIES.filter((c) => counts[c]).map((c) => <a class="chip" href={`/journal/category/${slugify(c)}/`}>{c} <span class="count">{counts[c]}</span></a>)}
    </nav>
  </div></section>
  <section><div class="wrap">
    <h2 class="sr-only">Latest posts</h2>
    <div class="grid-3">
      {posts.map((p) => <PostCard href={`/journal/${p.id}/`} image={p.data.cover} kicker={p.data.category} title={p.data.title} date={p.data.pubDate} summary={p.data.description} />)}
    </div>
  </div></section>
</Base>
