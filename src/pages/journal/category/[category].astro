---
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import { getPosts, getCategories } from "../../../lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  const cats = await getCategories();
  const withPosts = cats.filter((c) => posts.some((p) => p.data.category.id === c.id));
  return withPosts.map((c) => ({
    params: { category: c.id },
    props: { cat: c, others: withPosts, posts: posts.filter((p) => p.data.category.id === c.id) },
  }));
}
const { cat, others, posts } = Astro.props;
const name = cat.data.name;
---
<Base title={`${name} posts`} description={`${cat.data.description} Browse every Tidewell journal post about ${name.toLowerCase()}.`}>
  <section class="band page-head"><div class="wrap">
    <p class="eyebrow">Journal category</p>
    <h1>{name}</h1>
    <p class="lead">{cat.data.description}</p>
    <nav aria-label="Journal categories" class="chips">
      <a class="chip" href="/journal/">All posts</a>
      {others.map((c) => <a class="chip" href={`/journal/category/${c.id}/`} aria-current={c.id === cat.id ? "page" : undefined}>{c.data.name}</a>)}
    </nav>
  </div></section>
  <section><div class="wrap">
    <h2 class="sr-only">Posts in {name}</h2>
    <div class="grid-3">
      {posts.map((p) => <PostCard href={`/journal/${p.id}/`} image={p.data.cover} kicker={name} title={p.data.title} date={p.data.pubDate} summary={p.data.description} />)}
    </div>
  </div></section>
</Base>
