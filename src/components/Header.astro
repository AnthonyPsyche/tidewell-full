---
const path = Astro.url.pathname;
const links = [
  { href: "/journal/", label: "Journal" },
  { href: "/case-studies/", label: "Case studies" },
  { href: "/events/", label: "Events" },
  { href: "/team/", label: "Team" },
  { href: "/contact/", label: "Contact" },
];
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/"><img src="/img/logo-primary.svg" alt="Tidewell Coffee, home" width="200" height="40"></a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"><span class="sr-only">Menu</span><svg class="burger" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="b1" d="M3 6h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path class="b2" d="M3 12h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path class="b3" d="M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
    <nav id="site-nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={path.startsWith(l.href) ? "page" : undefined}>{l.label}</a>)}
    </nav>
  </div>
</header>
